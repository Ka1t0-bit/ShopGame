# ── Backend Dockerfile ──────────────────────────────────────────────────────────
FROM python:3.12-slim

# Системные зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем зависимости первыми (кэширование слоёв)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем исходники бэкенда
COPY app/ .

# Директория для SQLite базы данных (монтируется через volume)
RUN mkdir -p /data

# Переменные окружения по умолчанию
ENV DATABASE_URL="sqlite:////data/shop.db"
ENV CORS_ORIGINS="http://localhost:3000"

EXPOSE 8000

# Healthcheck — проверяем /health endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/ || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
